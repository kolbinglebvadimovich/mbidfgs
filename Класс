#include <iostream>
#include <string>

int main() 
{
    std::string answer;
    int counter = 0;

    std::cout << "Вы хотите указать начальное значение счётчика? Введите да или нет: " << std::endl;
    std::cin >> answer;

    if (answer == "да" || answer == "Да") 
    {
        std::cout << "Введите начальное значение счётчика: " << std::endl;
        std::cin >> counter;
    } else 
    {
        counter = 0;
    }

    char command;
    while (true) 
    {
        std::cout << "Введите команду ('+', '-', '=' или 'x'): " << std::endl;
        std::cin >> command;

        if (command == '+') 
        {
            counter++;
        } else if (command == '-') 
        {
            counter--;
        } else if (command == '=') 
        {
            std::cout << counter << "\n" << std::endl;
        } else if (command == 'x') 
        {
            std::cout << "До свидания!\n" << std::endl;
            break;
        } else 
        {
            std::cout << "Неверная команда.\n" << std::endl;
        }
    }

    return 0;
}
