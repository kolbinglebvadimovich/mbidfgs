#include <iostream>
#include <memory>
#include <string>

class Shape 
{
public:
    virtual ~Shape() = default;
    virtual void printInfo() const = 0;
    virtual int getSidesCount() const = 0;
    virtual std::string getName() const = 0;
};

class Triangle : public Shape 
{
protected:
    double a, b, c;
    double A, B, C;

public:
    Triangle(double a, double b, double c, double A, double B, double C)
        : a(a), b(b), c(c), A(A), B(B), C(C) {}

    int getSidesCount() const override { return 3; }

    std::string getName() const override { return "Треугольник"; }

    void printInfo() const override 
    {
        std::cout << getName() << ":\n" << std::endl;
        std::cout << "Стороны: a=" << a << " b=" << b << " c=" << c << "\n" << std::endl;
        std::cout << "Углы: A=" << A << " B=" << B << " C=" << C << "\n" << std::endl;
    }
};

class RightTriangle : public Triangle 
{
public:
    RightTriangle(double a, double b, double c, double A, double B, double C)
        : Triangle(a, b, c, A, B, C) {}

    std::string getName() const override { return "Прямоугольный треугольник"; }
};

class IsoscelesTriangle : public Triangle 
{
public:
    IsoscelesTriangle(double a, double b, double c, double A, double B, double C)
        : Triangle(a, b, c, A, B, C) {}

    std::string getName() const override { return "Равнобедренный треугольник"; }
};

class EquilateralTriangle : public Triangle 
{
public:
    EquilateralTriangle(double side, double angle)
        : Triangle(side, side, side, angle, angle, angle) {}

    std::string getName() const override { return "Равносторонний треугольник"; }
};

class Quadrilateral : public Shape 
{
protected:
    double a, b, c, d;
    double A, B, C, D;

public:
    Quadrilateral(double a, double b, double c, double d,
                  double A, double B, double C, double D)
        : a(a), b(b), c(c), d(d), A(A), B(B), C(C), D(D) {}

    int getSidesCount() const override { return 4; }

    std::string getName() const override { return "Четырёхугольник"; }

    void printInfo() const override 
    {
        std::cout << getName() << ":\n" << std:endl;
        std::cout << "Стороны: a=" << a << " b=" << b << " c=" << c << " d=" << d << "\n" << std:endl;
        std::cout << "Углы: A=" << A << " B=" << B << " C=" << C << " D=" << D << "\n" << std:endl;
    }
};

class Rectangle : public Quadrilateral 
{
public:
    Rectangle(double width, double height)
        : Quadrilateral(width, height, width, height, 90, 90, 90, 90) {}

    std::string getName() const override { return "Прямоугольник"; }
};

class Square : public Rectangle 
{
public:
    explicit Square(double side)
        : Rectangle(side, side) {}

    std::string getName() const override { return "Квадрат"; }
};

class Parallelogram : public Quadrilateral 
{
public:
    Parallelogram(double a, double b, double A, double B)
        : Quadrilateral(a, b, a, b, A, B, A, B) {}

    std::string getName() const override { return "Параллелограмм"; }
};

class Rhombus : public Parallelogram 
{
public:
    Rhombus(double side, double A, double B)
        : Parallelogram(side, side, A, B) {}

    std::string getName() const override { return "Ромб"; }
};

int main() 
{
    std::unique_ptr<Shape> t = std::make_unique<Triangle>(10, 20, 30, 50, 60, 70);
    std::unique_ptr<Shape> rt = std::make_unique<RightTriangle>(10, 20, 30, 50, 60, 90);
    std::unique_ptr<Shape> it = std::make_unique<IsoscelesTriangle>(10, 20, 10, 50, 60, 50);
    std::unique_ptr<Shape> et = std::make_unique<EquilateralTriangle>(30, 60);

    std::unique_ptr<Shape> q = std::make_unique<Quadrilateral>(10, 20, 30, 40, 50, 60, 70, 80);
    std::unique_ptr<Shape> rect = std::make_unique<Rectangle>(10, 20);
    std::unique_ptr<Shape> sq = std::make_unique<Square>(20);
    std::unique_ptr<Shape> para = std::make_unique<Parallelogram>(20, 30, 30, 40);
    std::unique_ptr<Shape> rh = std::make_unique<Rhombus>(30, 30, 40);

    // Выводим информацию о каждой фигуре
    t->printInfo();
    std::cout << "\n";

    rt->printInfo();
    std::cout << "\n" << std:endl;

    it->printInfo();
    std::cout << "\n" << std:endl;

    et->printInfo();
    std::cout << "\n" << std:endl;

    q->printInfo();
    std::cout << "\n" << std:endl;

    rect->printInfo();
    std::cout << "\n" << std:endl;

    sq->printInfo();
    std::cout << "\n" << std:endl;

    para->printInfo();
    std::cout << "\n" << std:endl;

    rh->printInfo();
    std::cout << "\n" << std:endl;

    return 0;
}
